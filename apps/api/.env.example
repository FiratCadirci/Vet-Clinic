# Yerel geliştirme: `npm run api` bu dosyayı (apps/api/.env) okuyup Spring Boot'u başlatır.
SERVER_PORT=3000
# Uygulama RLS'e tabi vet_app rolüyle bağlanır; migration'lar yönetici kullanıcıyla uygulanır.
DB_URL=jdbc:postgresql://localhost:5432/veterinery
DB_USERNAME=vet_app
DB_PASSWORD=change_me
FLYWAY_USER=vet
FLYWAY_PASSWORD=vet
# Üretimde mutlaka değiştirin (en az 32 karakter)
JWT_SECRET=gelistirme-icin-en-az-32-karakterlik-gizli-anahtar
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
# E-posta (Mailpit: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
WEB_URL=http://localhost:5173
# Expo push bildirimleri (true: gerçek Expo Push API'sine gönderir)
PUSH_ENABLED=false
STORAGE_ROOT=./storage
